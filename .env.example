# ==============================================================================
# SMARTCOST ENVIRONMENT CONFIGURATION TEMPLATE (ZERO SECRETS COMMITTED)
# Copy values into your hosting provider's Encrypted Environment Secrets UI.
# NEVER commit a real `.env` file to GitHub.
# ==============================================================================

# 1. Server-side Gemini AI Key (REQUIRED on Express Origin for Mr Cost AI)
# Set via hosting secret manager or `wrangler secret put GEMINI_API_KEY`
GEMINI_API_KEY=""

# 2. HMAC Session Signing Secret (RECOMMENDED strong 64-char hex random string)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# 3. Runtime Application URL (Injected by host, e.g. Cloud Run / Express origin URL)
APP_URL=""

# 4. External Express Backend URL (Build-time Vite var, optional)
# Leave empty ("") for same-origin hosting.
# Set to your external backend URL (e.g. https://smartcost-backend.onrender.com) when frontend is on Cloudflare:
VITE_API_BASE_URL=""

# 5. Express Origin URL for Cloudflare Worker Reverse Proxy (Set as encrypted secret via `wrangler secret put ORIGIN_API_URL`)
ORIGIN_API_URL=""

# 6. Optional Additional CORS Origins (comma-separated, *.pages.dev / *.workers.dev are already allowlisted safely)
ALLOWED_ORIGINS=""

# 7. Optional Cloudflare Worker Developer Alt+D Passkey Secret (if not using Google Developer Sign-In or ORIGIN_API_URL)
DEV_ACCESS_SECRET=""
DEV_USERNAME=""

